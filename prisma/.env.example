# =====================================================
# RUANG JAJAN - ENVIRONMENT VARIABLES
# Production-ready configuration for Railway PostgreSQL
# =====================================================

# =====================================================
# DATABASE (Railway PostgreSQL)
# =====================================================

# Primary database URL (get from Railway dashboard)
DATABASE_URL="postgresql://postgres:your_password@containers-us-west-1.railway.app:1234/railway?schema=public"

# Read replica for heavy read operations (optional)
DATABASE_URL_REPLICA="postgresql://postgres:your_password@containers-us-west-1.railway.app:1234/railway?schema=public"

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_POOL_SIZE=100
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=600000
DATABASE_STATEMENT_TIMEOUT=30000

# =====================================================
# REDIS CACHING ( Railway Redis )
# =====================================================

REDIS_URL="redis://:your_password@containers-us-west-1.railway.app:1234/0"
REDIS_PASSWORD="your_redis_password"

# Cache TTL settings (in seconds)
CACHE_TTL_PRODUCT=3600        # 1 hour for products
CACHE_TTL_CATEGORY=86400      # 24 hours for categories
CACHE_TTL_USER_SESSION=604800 # 7 days for sessions
CACHE_TTL_CART=86400          # 24 hours for cart
CACHE_TTL_ANALYTICS=300       # 5 minutes for analytics

# =====================================================
# AUTHENTICATION
# =====================================================

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_TOKEN_EXPIRY="15m"
JWT_REFRESH_TOKEN_EXPIRY="7d"
JWT_RESET_TOKEN_EXPIRY="1h"

# Password Hashing
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_SECRET="your-session-secret-key"
SESSION_MAX_AGE=604800000 # 7 days in milliseconds

# =====================================================
# EMAIL & NOTIFICATIONS
# =====================================================

# SMTP Configuration (for transactional emails)
SMTP_HOST="smtp.railway.app"
SMTP_PORT=587
SMTP_USER="your_smtp_user"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@ruangjajan.com"
SMTP_FROM_NAME="Ruang Jajan"

# WhatsApp API (for order notifications)
WHATSAPP_API_URL="https://api.whatsapp.com/v1"
WHATSAPP_API_TOKEN="your_whatsapp_api_token"
WHATSAPP_PHONE_NUMBER="6285240174510"

# =====================================================
# PAYMENT GATEWAYS
# =====================================================

# Midtrans (Indonesian payment gateway)
MIDTRANS_SERVER_KEY="your_midtrans_server_key"
MIDTRANS_CLIENT_KEY="your_midtrans_client_key"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# Xendit (Alternative payment gateway)
XENDIT_SECRET_KEY="your_xendit_secret_key"
XENDIT_PUBLIC_KEY="your_xendit_public_key"
XENDIT_CALLBACK_TOKEN="your_xendit_callback_token"

# =====================================================
# SHIPPING PROVIDERS
# =====================================================

# RajaOngkir (Indonesian shipping API)
RAJAONGKIR_API_KEY="your_rajaongkir_api_key"
RAJAONGKIR_BASE_URL="https://api.rajaongkir.com/starter"

# JNE API
JNE_API_KEY="your_jne_api_key"
JNE_API_URL="https://api.jne.co.id"

# =====================================================
# STORAGE & CDN
# =====================================================

# AWS S3 (for image uploads)
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="ap-southeast-3"
AWS_S3_BUCKET="ruangjajan-uploads"
AWS_S3_URL="https://ruangjajan-uploads.s3.ap-southeast-3.amazonaws.com"

# Cloudflare CDN
CDN_URL="https://cdn.ruangjajan.com"
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# =====================================================
# RATE LIMITING
# =====================================================

RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100      # 100 requests per window
RATE_LIMIT_STRICT_WINDOW_MS=60000 # 1 minute for strict limits
RATE_LIMIT_STRICT_MAX_REQUESTS=10 # 10 requests per minute

# =====================================================
# SECURITY
# =====================================================

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key"
ENCRYPTION_IV="your-16-char-iv!"

# CORS
CORS_ORIGIN="https://ruangjajan.com"
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Helmet & Security Headers
ALLOWED_HOSTS="ruangjajan.com,www.ruangjajan.com,api.ruangjajan.com"

# =====================================================
# ANALYTICS & TRACKING
# =====================================================

# Google Analytics
GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GA_API_SECRET="your_ga_api_secret"

# PostHog (Product analytics)
POSTHOG_API_KEY="your_posthog_api_key"
POSTHOG_HOST="https://app.posthog.com"

# =====================================================
# APPLICATION
# =====================================================

# App Configuration
NODE_ENV="production"
PORT=3000
API_VERSION="v1"
APP_URL="https://ruangjajan.com"
API_URL="https://api.ruangjajan.com"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="json"
LOG_DIR="./logs"

# Feature Flags
FEATURE_MULTI_CURRENCY=false
FEATURE_MULTI_LANGUAGE=true
FEATURE_WISHLIST=true
FEATURE_REVIEWS=true
FEATURE_NEWSLETTER=true

# =====================================================
# MAINTENANCE & BACKUP
# =====================================================

# Database Backup
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH="./backups"

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site is under maintenance. Please try again later."

# =====================================================
# RAILWAY SPECIFIC
# =====================================================

RAILWAY_ENVIRONMENT="production"
RAILWAY_SERVICE_NAME="ruangjajan-api"
RAILWAY_PROJECT_ID="your_project_id"