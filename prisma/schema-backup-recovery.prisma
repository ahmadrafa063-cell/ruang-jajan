// =====================================================
// RUANG JAJAN - PRODUCTION DATABASE SCHEMA
// PostgreSQL + Prisma ORM + TypeScript
// =====================================================

generator client {
  provider            = "prisma-client-js"
  previewFeatures     = ["fullTextSearch", "fullTextIndex", "postgresqlExtensions"]
  strictTypes         = true
  emitSingleQueries   = false
  emitPreparedMethods = true
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// =====================================================
// ENUMS - Complete list matching seed.ts
// =====================================================

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  OUT_OF_STOCK
}

enum ProductBadge {
  NEW
  BEST_SELLER
  SPICY
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  HALAL
  ORGANIC
  LIMITED_EDITION
  SEASONAL
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  ON_HOLD
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  QRIS
  CREDIT_CARD
  DEBIT_CARD
  E_WALLET
  SHOPEEPAY
  GOPAY
  OVO
  DANA
}

enum ShippingStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ShippingProvider {
  JNE
  JandT
  SICEPAT
  ANTERAJA
  GOJEK
  GRAB
  INSTANT
  SELF_PICKUP
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_ONE_GET_ONE
}

enum DiscountApplicability {
  ALL_PRODUCTS
  SPECIFIC_PRODUCTS
  SPECIFIC_CATEGORIES
  MINIMUM_ORDER
  FIRST_ORDER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum EventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  CHECKOUT_START
  CHECKOUT_COMPLETE
  SEARCH
  FILTER_APPLIED
  WISHLIST_ADD
  WISHLIST_REMOVE
  SHARE
  DOWNLOAD
  SIGNUP
  LOGIN
  LOGOUT
}

enum ActivityLogType {
  USER_ACTION
  SYSTEM_ACTION
  ADMIN_ACTION
  SECURITY_EVENT
  ORDER_EVENT
  INVENTORY_EVENT
  PAYMENT_EVENT
}

enum NotificationType {
  ORDER_UPDATE
  PROMOTION
  SYSTEM
  REVIEW
  WISHLIST
  ABANDONED_CART
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

// =====================================================
// USER MANAGEMENT
// =====================================================

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  email           String    @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime? @db.Timestamptz(6)

  firstName   String
  lastName    String
  phone       String?   @unique
  avatar      String?
  bio         String?
  dateOfBirth DateTime? @db.Date

  role        UserRole   @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @db.Timestamptz(6)
  lastLoginIp String?

  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime? @db.Timestamptz(6)
  passwordChangedAt   DateTime  @default(now()) @db.Timestamptz(6)

  preferredLanguage String  @default("id")
  preferredCurrency String  @default("IDR")
  marketingConsent  Boolean @default(false)

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  carts         Cart[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  sessions      Session[]

  @@index([email])
  @@index([phone])
  @@index([role, status])
  @@index([deletedAt, status])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId         String
  token          String   @unique
  expiresAt      DateTime @db.Timestamptz(6)
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId String
  type   String  @default("home")
  label  String?

  recipientName  String
  recipientPhone String
  streetAddress  String
  addressLine2   String?
  village        String
  district       String
  city           String
  province       String
  postalCode     String
  country        String  @default("Indonesia")

  latitude  Float?
  longitude Float?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

// =====================================================
// PRODUCT MANAGEMENT
// =====================================================

model Category {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  name        String
  slug        String  @unique
  description String?
  image       String?
  parentId    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  metaTitle       String?
  metaDescription String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  name             String
  slug             String  @unique
  description      String  @db.Text
  shortDescription String?

  price          Decimal  @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  sku               String  @unique
  barcode           String?
  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(10)
  trackInventory    Boolean @default(true)
  allowBackorder    Boolean @default(false)

  status     ProductStatus @default(DRAFT)
  isFeatured Boolean       @default(false)
  isActive   Boolean       @default(true)

  weight Decimal? @db.Decimal(8, 2)
  length Decimal? @db.Decimal(8, 2)
  width  Decimal? @db.Decimal(8, 2)
  height Decimal? @db.Decimal(8, 2)

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images        ProductImage[]
  badges        ProductBadgeRelation[]
  variants      ProductVariant[]
  reviews       Review[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  tags          ProductTag[]
  discounts     DiscountProduct[]
  analytics     ProductAnalytics[]

  averageRating          Decimal?                 @db.Decimal(3, 2)
  reviewCount            Int                      @default(0)
  viewCount              Int                      @default(0)
  soldCount              Int                      @default(0)
  ProductBadgeOnProducts ProductBadgeOnProducts[]

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([status, isActive])
  @@index([isFeatured, status])
  @@index([price])
  @@index([createdAt])
  @@index([deletedAt, status])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductBadgeRelation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  badgeName   ProductBadge @unique
  displayName String
  icon        String?
  color       String?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)

  products  ProductBadgeOnProducts[]
  Product   Product?                 @relation(fields: [productId], references: [id])
  productId String?

  @@map("product_badges")
}

model ProductBadgeOnProducts {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  productId String
  badgeName ProductBadge

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  badge   ProductBadgeRelation @relation(fields: [badgeName], references: [badgeName], onDelete: Cascade)

  @@unique([productId, badgeName])
  @@index([productId])
  @@index([badgeName])
  @@map("product_badges_on_products")
}

model ProductVariant {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  productId     String
  name          String
  sku           String?  @unique
  price         Decimal? @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  attributes    Json
  isActive      Boolean  @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Tag {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  name  String  @unique
  slug  String  @unique
  color String?

  products ProductTag[]

  @@index([slug])
  @@map("tags")
}

model ProductTag {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@map("product_tags")
}

// =====================================================
// CART & WISHLIST
// =====================================================

model Cart {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId    String? @unique
  sessionId String? @unique
  isActive  Boolean @default(true)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  cartId    String
  productId String
  variantId String?
  quantity  Int     @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId   String  @unique
  isActive Boolean @default(true)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  wishlistId String
  productId  String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// =====================================================
// ORDERS & CHECKOUT
// =====================================================

model Order {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  orderNumber String      @unique
  status      OrderStatus @default(PENDING)

  userId     String?
  guestEmail String?
  guestPhone String?

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  shippingCost   Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  shippingAddressId String?
  billingAddressId  String?

  orderedAt   DateTime? @db.Timestamptz(6)
  confirmedAt DateTime? @db.Timestamptz(6)
  shippedAt   DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  cancelledAt DateTime? @db.Timestamptz(6)

  customerNotes String? @db.Text
  internalNotes String? @db.Text

  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])

  items      OrderItem[]
  payment    Payment?
  shipment   Shipment?
  invoice    Invoice?
  discount   Discount?   @relation(fields: [discountId], references: [id])
  discountId String?

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderedAt])
  @@map("orders")
}

model OrderItem {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  orderId   String
  productId String
  variantId String?

  productName String
  productSku  String
  variantName String?

  unitPrice      Decimal @db.Decimal(12, 2)
  quantity       Int
  totalPrice     Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  status OrderStatus @default(PENDING)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// =====================================================
// PAYMENTS
// =====================================================

model Payment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  orderId String @unique

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount         Decimal @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)
  refundedAmount Decimal @default(0) @db.Decimal(12, 2)

  paymentGateway String?
  transactionId  String?
  paymentToken   String?
  paymentUrl     String?

  paidAt    DateTime? @db.Timestamptz(6)
  expiredAt DateTime? @db.Timestamptz(6)

  metadata      Json?
  failureReason String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

// =====================================================
// SHIPPING
// =====================================================

model Shipment {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  orderId String @unique

  provider       ShippingProvider
  trackingNumber String?
  trackingUrl    String?

  status ShippingStatus @default(PENDING)

  shippingCost Decimal  @db.Decimal(12, 2)
  weight       Decimal? @db.Decimal(8, 2)

  pickedUpAt       DateTime? @db.Timestamptz(6)
  inTransitAt      DateTime? @db.Timestamptz(6)
  outForDeliveryAt DateTime? @db.Timestamptz(6)
  deliveredAt      DateTime? @db.Timestamptz(6)
  failedAt         DateTime? @db.Timestamptz(6)
  returnedAt       DateTime? @db.Timestamptz(6)

  notes String? @db.Text

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ShipmentEvent {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  shipmentId  String
  status      ShippingStatus
  location    String?
  description String?
  occurredAt  DateTime       @db.Timestamptz(6)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([occurredAt])
  @@map("shipment_events")
}

// =====================================================
// INVOICES
// =====================================================

model Invoice {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  orderId String @unique

  invoiceNumber String   @unique
  invoiceDate   DateTime @db.Date
  dueDate       DateTime @db.Date

  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2)
  shippingCost   Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  pdfUrl String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// =====================================================
// DISCOUNTS & PROMOTIONS
// =====================================================

model Discount {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  code          String                @unique
  name          String
  description   String?
  type          DiscountType
  applicability DiscountApplicability

  value             Decimal  @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @db.Decimal(12, 2)
  minOrderAmount    Decimal? @db.Decimal(12, 2)
  maxUsage          Int?
  maxUsagePerUser   Int?

  usedCount   Int @default(0)
  usedByUsers Int @default(0)

  startsAt  DateTime @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  products DiscountProduct[]
  orders   Order[]

  @@index([code])
  @@index([isActive])
  @@index([startsAt, expiresAt])
  @@map("discounts")
}

model DiscountProduct {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  discountId String
  productId  String

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
  @@index([discountId])
  @@index([productId])
  @@map("discount_products")
}

// =====================================================
// REVIEWS & RATINGS
// =====================================================

model Review {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId    String
  productId String

  rating  Int
  title   String?
  content String  @db.Text

  status ReviewStatus @default(PENDING)

  moderatedAt     DateTime? @db.Timestamptz(6)
  moderatedBy     String?
  rejectionReason String?

  helpfulCount   Int @default(0)
  unhelpfulCount Int @default(0)

  images ReviewImage[]

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewImage {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  reviewId  String
  url       String
  sortOrder Int    @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_images")
}

// =====================================================
// ANALYTICS & TRACKING
// =====================================================

model ProductAnalytics {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  productId String
  date      DateTime @db.Date

  viewCount       Int     @default(0)
  uniqueViewCount Int     @default(0)
  cartAddCount    Int     @default(0)
  purchaseCount   Int     @default(0)
  revenue         Decimal @default(0) @db.Decimal(14, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([productId])
  @@index([date])
  @@map("product_analytics")
}

model AnalyticsEvent {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  type      EventType
  sessionId String?
  userId    String?

  pageUrl     String?
  referrerUrl String?

  productId   String?
  searchQuery String?

  userAgent  String?
  ipAddress  String?
  deviceType String?
  browser    String?
  os         String?
  country    String?
  city       String?

  metadata Json?

  @@index([type])
  @@index([sessionId])
  @@index([userId])
  @@index([productId])
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("analytics_events")
}

// =====================================================
// NOTIFICATIONS
// =====================================================

model Notification {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId String?

  type    NotificationType
  channel NotificationChannel @default(IN_APP)

  title   String
  message String

  isRead Boolean   @default(false)
  readAt DateTime? @db.Timestamptz(6)

  sentAt        DateTime? @db.Timestamptz(6)
  deliveredAt   DateTime? @db.Timestamptz(6)
  failedAt      DateTime? @db.Timestamptz(6)
  failureReason String?

  actionUrl String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// =====================================================
// ACTIVITY LOGS
// =====================================================

model ActivityLog {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  userId String?

  type        ActivityLogType
  action      String
  description String?

  entityType String?
  entityId   String?

  ipAddress String?
  userAgent String?

  oldData Json?
  newData Json?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// =====================================================
// FULL-TEXT SEARCH
// =====================================================

model SearchIndex {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  entityType String
  entityId   String

  title        String
  content      String                   @db.Text
  searchVector Unsupported("tsvector")?

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([searchVector])
  @@map("search_indexes")
}

// =====================================================
// RECOMMENDATIONS
// =====================================================

model ProductRecommendation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  productId            String
  recommendedProductId String

  type  String
  score Decimal @db.Decimal(5, 4)

  expiresAt DateTime? @db.Timestamptz(6)

  @@unique([productId, recommendedProductId, type])
  @@index([productId])
  @@index([type])
  @@map("product_recommendations")
}

// =====================================================
// DATABASE MAINTENANCE
// =====================================================

model DatabaseMigration {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  name          String   @unique
  version       String
  appliedAt     DateTime @default(now()) @db.Timestamptz(6)
  checksum      String
  executionTime Int
  success       Boolean
  errorMessage  String?

  @@index([name])
  @@index([appliedAt])
  @@map("database_migrations")
}

model DatabaseBackup {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  filename    String
  size        BigInt
  storagePath String

  backupType String
  status     String

  startedAt   DateTime  @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)

  checksum     String?
  errorMessage String?

  @@index([status])
  @@index([createdAt])
  @@map("database_backups")
}
