rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 256
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.isAdmin == false; // Users cannot make themselves admin
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 128
        && data.price is number && data.price >= 0
        && data.category in ['Food', 'Drinks', 'Snacks', 'Desserts']
        && data.image is string && data.image.size() <= 1024;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid
        && data.items is list && data.items.size() > 0 && data.items.size() <= 50
        && data.total is number && data.total >= 0
        && data.status in ['pending', 'confirmed', 'delivering', 'completed', 'cancelled']
        && data.customerDetails is map
        && data.customerDetails.name is string && data.customerDetails.name.size() <= 128
        && data.customerDetails.phone is string && data.customerDetails.phone.size() <= 32
        && data.customerDetails.address is string && data.customerDetails.address.size() <= 512;
    }

    // --- Collection Matches ---

    // 1. Users
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && userId == request.auth.uid;
      allow update: if isSignedIn() && userId == request.auth.uid 
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
        && isValidUser(incoming());
    }

    // 2. Products
    match /products/{productId} {
      allow read: if true; // Publicly viewable menu
      allow write: if isAdmin(); // Only admins can manage products
    }

    // 3. Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow update: if isAdmin(); // Only admins can update order status
    }

    // 4. Admin List (System Protected)
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // Managed via Firebase Console for security
    }
  }
}
