{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food or beverage item available for purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Name of the food item" },
        "description": { "type": "string", "description": "Brief description of the item" },
        "price": { "type": "number", "description": "Price in local currency" },
        "category": { "type": "string", "enum": ["Food", "Drinks", "Snacks", "Desserts"] },
        "image": { "type": "string", "description": "URL to the product image" },
        "rating": { "type": "number", "description": "Star rating out of 5" },
        "badges": { "type": "array", "items": { "type": "string" }, "description": "Tags like 'Best Seller', 'New', 'Spicy'" },
        "isAvailable": { "type": "boolean", "description": "Availability status" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array", "items": { "type": "object" } },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "delivering", "completed", "cancelled"] },
        "customerDetails": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "address": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "paymentMethod": { "type": "string", "enum": ["COD", "Bank Transfer", "E-Wallet"] },
        "platform": { "type": "string", "enum": ["WhatsApp", "Shopee", "Web"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "User": {
      "title": "User",
      "description": "App user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "Global food menu items"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer order history"
    },
    "users": {
      "schema": "User",
      "description": "User profiles and permissions"
    }
  }
}
